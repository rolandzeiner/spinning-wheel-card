{
  "name": "spinning-wheel-card",
  "version": "1.5.0",
  "private": true,
  "description": "Standalone Lovelace custom card — a click-to-spin / drag-to-flick wheel with momentum-based physics.",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "dev": "vp build --watch --mode development",
    "build:push": "./scripts/dev-push.sh --quiet",
    "test": "vp test run",
    "check": "vp check"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "happy-dom": "21.0.3",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.0 || >=26.0.0"
    }
  }
}
