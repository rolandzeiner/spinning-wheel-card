{
  "name": "spinning-wheel-card",
  "private": true,
  "version": "1.4.2",
  "description": "Standalone Lovelace custom card — a click-to-spin / drag-to-flick wheel with momentum-based physics.",
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown -c -w",
    "build:push": "rolldown -c && ./scripts/dev-push.sh --quiet",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "happy-dom": "20.14.0",
    "rolldown": "1.2.9",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "lit": "^3.3.3"
  }
}
