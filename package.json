{
  "name": "spinning-wheel-card",
  "private": true,
  "version": "1.4.2",
  "description": "Standalone Lovelace custom card — a click-to-spin / drag-to-flick wheel with momentum-based physics.",
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown -c -w",
    "build:push": "./scripts/dev-push.sh --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=src/** --coverage.reporter=json --coverage.reporter=text-summary"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.2",
    "happy-dom": "20.14.5",
    "rolldown": "1.2.11",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "lit": "^3.3.3"
  }
}
